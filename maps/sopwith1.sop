// Mod that reproduces the "Sopwith 1" title screen and title screen
// music, which was changed in later versions.

title {
	text {
		text: "S O P W I T H"
		x: 13
		y: 9
	}
	text {
		text: "BMB"
		x: 12
		y: 12
		color: 1
	}
	text {
		text: "Compuscience"
		x: 16
		y: 12
	}
}

sounds {
	// Old "Sopwith 1" tune (Merrily We Roll Along):
	title_tune:
	">e4./d8/c4/d4/e4/d+4/e4/c4/d4/d4/d4/d1/"&
	"d4./c8/<b4/>c4/d4/c+4/d4/<b4/>c4/c4/c4/c1/<g4./g+8/"&
	"a4./a-8/g4./g+8/a4/a-4/g4/>d4/d4/d2./<g4./g+8/"&
	"a4./a-8/g4./g+8/a4/a-4/g4/>e4/e4/e2./"&
	"e4./d8/c4/d4/e4/d+4/e4/c4/d4/d4/d4/d2/c4/<g+4/a4/>"&
	"d2/e2/g1/"
}
