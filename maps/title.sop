
// Example of how to replace the title screen.

title {
	text {
		x: 5
		y: 1
		color: 1
		text: "Hello world!"
	}
	text {
		x: 8
		y: 3
		color: 2
		text: "This is an example"
	}
	text {
		x: 11
		y: 5
		color: 3
		text: "of a custom title screen!"
	}

	// Cyan planes...
	symbol {
		name: swplnsym
		frame: 0
		transform: 0
		x: 15
		y: 150
		faction: PLAYER5
	}
	symbol {
		name: swplnsym
		frame: 0
		transform: 0
		x: 15
		y: 130
		faction: PLAYER3
	}
	symbol {
		name: swplnsym
		frame: 0
		transform: 0
		x: 45
		y: 140
		faction: PLAYER1
	}

	// vs. magenta planes:
	symbol {
		name: swplnsym
		frame: 0
		transform: 6
		x: 265
		y: 140
		faction: PLAYER2
	}
	symbol {
		name: swplnsym
		frame: 0
		transform: 6
		x: 295
		y: 150
		faction: PLAYER6
	}
	symbol {
		name: swplnsym
		frame: 0
		transform: 6
		x: 295
		y: 130
		faction: PLAYER4
	}

